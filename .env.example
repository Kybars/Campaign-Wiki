OPENAI_API_KEY=
# Backward-compatible fallback for both stage-specific settings below.
OPENAI_MODEL=gpt-5.6-terra
# Optional. Each falls back to OPENAI_MODEL when omitted.
OPENAI_EXTRACTION_MODEL=
OPENAI_RECONCILIATION_MODEL=
OPENAI_ENRICHMENT_MODEL=

# Structured-model provider. Defaults to openai.
AI_PROVIDER=openai
# Server-side campaign processing mode. Defaults to lean; use full only for explicit legacy enrichment/reference runs.
CAMPAIGN_PROCESSING_MODE=lean
# Required only when AI_PROVIDER=local. Server-side development settings.
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=
# Optional stage overrides. Each falls back to LOCAL_AI_MODEL.
LOCAL_AI_EXTRACTION_MODEL=
LOCAL_AI_RECONCILIATION_MODEL=
LOCAL_AI_ENRICHMENT_MODEL=
LOCAL_AI_API_KEY=
# Local enrichment is a rehearsal by default. Set exactly `true` only for a disposable campaign whose canonical output may be replaced.
LOCAL_AI_ALLOW_PERSISTENCE=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Campaign imports
# Optional. Defaults to true locally and false on Vercel.
ALLOW_CAMPAIGN_UPLOADS=

# Optional tuning
AI_EXTRACTION_CONCURRENCY=3
# Local inference defaults to one extraction request at a time.
LOCAL_AI_EXTRACTION_CONCURRENCY=1
# Server-only application-level OpenAI attempt ceiling. Reused checkpoints and local calls do not consume it.
OPENAI_MAX_CALLS_PER_RUN=40
PDF_CHUNK_TARGET_CHARACTERS=45000
